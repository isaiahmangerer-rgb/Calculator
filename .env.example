# Public Supabase project settings (safe to expose to the browser; RLS remains mandatory)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_GUEST_CHAT_ENABLED=false

# Canonical production origin used for auth redirects and social metadata
NEXT_PUBLIC_SITE_URL=https://YOUR_PROJECT.vercel.app

# Server-only search credential. Never prefix this with NEXT_PUBLIC_.
SEARCH_API_PROVIDER=langsearch
LANGSEARCH_API_KEY=YOUR_LANGSEARCH_API_KEY

# Comma-separated exact domains or explicit subdomain wildcards (for example: example.com,*.wikipedia.org)
ALLOWED_PREVIEW_DOMAINS=developer.mozilla.org,en.wikipedia.org
PREVIEW_TIMEOUT_MS=5000
PREVIEW_MAX_BYTES=750000

# Moderation controls
PROFANITY_FILTER_ENABLED=true
MESSAGE_RATE_LIMIT_PER_MINUTE=24
